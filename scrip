      helper.select(); document.execCommand('copy'); helper.remove(); $('#copyCode').textContent = 'Â¡Copiado!';
    }
  });
  const resetReportForm = () => {
    reportForm.reset();
    $('#formMessage').textContent = '';
    $('#photoName').textContent = 'Puedes elegir una imagen como referencia. No se sube a un servidor.';
    $('#locationHint').textContent = 'TambiÃ©n puedes escribir la ubicaciÃ³n manualmente.';
    $('#copyCode').textContent = 'Copiar cÃ³digo';
    successPanel.hidden = true;
    reportForm.hidden = false;
  };
  $('#finishSuccess').addEventListener('click', () => {
    resetReportForm();
    if (reportDialog.open) reportDialog.close();
  });
  $('#newReportButton').addEventListener('click', () => {
    resetReportForm();
    $('#category').value = '';
    $('#citizenName').focus();
  });
  reportDialog.addEventListener('close', () => {
    $('#copyCode').textContent = 'Copiar cÃ³digo';
    resetReportForm();
  });
  $('#lookupButton').addEventListener('click', () => {
    const code = $('#trackingCode').value.trim().toUpperCase();
    if (!code) { $('#trackingResult').innerHTML = '<div class="empty-state-icon">âŒ¨ï¸</div><h3>Introduce tu cÃ³digo</h3><p>Escribe el cÃ³digo que recibiste al registrar el reporte.</p>'; return; }
    const report = readReports().find(item => item.code.toUpperCase() === code);
    if (!report) {
      $('#trackingResult').innerHTML = `<div class="empty-state-icon">ðŸ”Ž</div><h3>No encontramos ese cÃ³digo</h3><p>Verifica que estÃ© bien escrito y que el reporte se haya registrado en este mismo navegador. <button class="button button-outline" id="newReportFromLookup" type="button">Registrar un reporte</button></p>`;
      $('#newReportFromLookup').addEventListener('click', () => showForm());
      return;
    }
    renderReport(report);
  });
  $('#trackingCode').addEventListener('keydown', event => { if (event.key === 'Enter') { event.preventDefault(); $('#lookupButton').click(); } });

  function renderReport(report) {
    const states = ['Recibido', 'En revisiÃ³n', 'En proceso', 'Atendido', 'Resuelto'];
    const index = Math.max(0, states.indexOf(report.status));
    const progress = Math.round(((index + 1) / states.length) * 100);
    $('#trackingResult').innerHTML = `
      <div class="result-top"><span class="eyebrow">REPORTE ${escapeHTML(report.code)}</span><span class="state-pill">${escapeHTML(report.status)}</span></div>
      <h3>${escapeHTML(report.category)}</h3>
      <p>${escapeHTML(report.description)}</p>
      <div class="result-meta">
        <div><span>UbicaciÃ³n</span><strong>${escapeHTML(report.location)}</strong></div>
        <div><span>Fecha de registro</span><strong>${escapeHTML(report.createdLabel || new Date(report.createdAt).toLocaleString('es-BO'))}</strong></div>
        <div><span>Nombre</span><strong>${escapeHTML(report.name)}</strong></div>
        <div><span>CÃ³digo</span><strong>${escapeHTML(report.code)}</strong></div>
      </div>
      <span class="eyebrow">PROGRESO LOCAL</span><div class="progress-track"><div class="progress-fill" style="width:${progress}%"></div></div>
      <p class="progress-label">${progress}% Â· Estado guardado: ${escapeHTML(report.status)}. No representa una actualizaciÃ³n institucional.</p>`;
  }

  $('#privacyLink').addEventListener('click', event => {
    event.preventDefault();
    const dialog = $('#privacyDialog');
    if (dialog.showModal) dialog.showModal(); else dialog.setAttribute('open', '');
  });
  $('#closePrivacy').addEventListener('click', () => $('#privacyDialog').close());
  $('#privacyOkay').addEventListener('click', () => $('#privacyDialog').close());
  $('#year').textContent = new Date().getFullYear();

  // El nÃºmero se normaliza a formato internacional boliviano para el enlace de WhatsApp.
  // La versiÃ³n frontend no puede enviar mensajes automÃ¡ticamente sin backend/API autorizada.
})();
